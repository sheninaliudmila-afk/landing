# Public build-time setting. Empty = training mode with local TXT download.
# Rebuild the site after changing this value.
VITE_CONTACT_ENDPOINT=

# Example for a future API (deploy and configure the server separately):
# VITE_CONTACT_ENDPOINT=https://api.example.com/contact

# NEVER put SUPABASE_SERVICE_ROLE_KEY, LOVABLE_API_KEY or other secrets in VITE_*.
# Server-only variables belong in the backend hosting environment, not here.
